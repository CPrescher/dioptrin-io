from os import PathLike
from typing import Any
import numpy as np
from numpy.typing import NDArray

class UnsupportedFusedLayout(ValueError): ...
class SourceImageMismatch(ValueError): ...
class FusedResult:
    @property
    def radial(self) -> list[float]: ...
    @property
    def intensity(self) -> list[float]: ...
    @property
    def errors(self) -> list[float] | None: ...
class FusedHdf5Integrator:
    def __init__(self, path: str | PathLike[str], dataset: str,
                 poni: dict[str, float], n_points: int, *,
                 mask: NDArray[np.uint8] | None = None,
                 polarization_factor: float | None = None,
                 unit: str = "2th_deg", supersampling: int = 1,
                 num_workers: int = 8) -> None: ...
    @property
    def num_workers(self) -> int: ...
    def set_source(self, path: str | PathLike[str], dataset: str) -> None: ...
    def load_integrate1d(self, frame: int, *, errors: bool = False) -> tuple[NDArray[Any], FusedResult]: ...
    def integrate1d(self, frame: int, *, errors: bool = False,
                    expected_image: NDArray[np.float64] | None = None) -> FusedResult: ...
