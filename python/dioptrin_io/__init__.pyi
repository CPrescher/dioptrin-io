from os import PathLike
from typing import Any, Iterator
import numpy as np
from numpy.typing import NDArray

__version__: str

class Image:
    @property
    def data(self) -> NDArray[Any]: ...
    @property
    def header(self) -> dict[str | int, Any]: ...
    @property
    def metadata(self) -> dict[str, Any]: ...

class Reader:
    def __init__(self, path: str | bytes | PathLike, *, dataset: str | None = None) -> None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def nframes(self) -> int: ...
    def __len__(self) -> int: ...
    def __getitem__(self, frame: int) -> Image: ...
    def __iter__(self) -> Iterator[Image]: ...
    def read(self, frame: int = 0) -> Image: ...
    def header(self, frame: int = 0) -> dict[str | int, Any]: ...
    def metadata(self, frame: int = 0) -> dict[str, Any]: ...
    def close(self) -> None: ...
    def __enter__(self) -> Reader: ...
    def __exit__(self, *args: Any) -> None: ...

def open(path: str | bytes | PathLike, *, dataset: str | None = None) -> Reader: ...
